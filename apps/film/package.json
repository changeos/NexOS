{
  "name": "nexos-app-film",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "NexOS 应用包：影片制作（短片生成 + 高级全流程）——ShotGen 直连 video 渠道单段生成；高级模式=FilmHub/工作室全管线（创意 → 分镜 → 生图 → 生视频 → 配音 → 合成）",
  "scripts": {
    "build": "vite build && vite build --config vite.standalone.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "smoke": "node scripts/preview-smoke.mjs && node scripts/flow-smoke.mjs && node scripts/hub-smoke.mjs && node scripts/toast-smoke.mjs && node scripts/shotgen-smoke.mjs",
    "smoke:preview": "node scripts/preview-smoke.mjs",
    "smoke:flow": "node scripts/flow-smoke.mjs",
    "smoke:hub": "node scripts/hub-smoke.mjs",
    "smoke:toast": "node scripts/toast-smoke.mjs",
    "smoke:shotgen": "node scripts/shotgen-smoke.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-i18n": "^9.14.5",
    "vue-tsc": "^3.3.8"
  }
}