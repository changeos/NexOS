{
  "name": "nexos-app-film",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "NexOS 应用包：影片制作（AI 影片管线）——从 NexHub 仓库安装到 NexOS 桌面",
  "scripts": {
    "build": "vite build && vite build --config vite.standalone.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "smoke": "node scripts/preview-smoke.mjs && node scripts/flow-smoke.mjs && node scripts/hub-smoke.mjs",
    "smoke:preview": "node scripts/preview-smoke.mjs",
    "smoke:flow": "node scripts/flow-smoke.mjs",
    "smoke:hub": "node scripts/hub-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-i18n": "^9.14.5",
    "vue-tsc": "^3.3.8"
  }
}